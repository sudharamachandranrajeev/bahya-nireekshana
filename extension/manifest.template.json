{
  "manifest_version": 3,
  "name": "Bahya Nireekshana",
  "short_name": "Nireekshana",
  "version": "0.1.0",
  "description": "Shows how much data each website uses. No accounts, no tracking. All data stays on this device.",
  "homepage_url": "https://github.com/sudharamachandranrajeev/bahya-nireekshana",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nireekshana",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "dashboard/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "entry": "background.js"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"]
}
