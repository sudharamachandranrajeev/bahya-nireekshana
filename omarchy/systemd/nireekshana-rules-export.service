[Unit]
Description=Export OpenSnitch rules and nireekshana lists for the bar widget
Documentation=file:///usr/local/bin/nireekshana-rules
After=opensnitchd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nireekshana-rules export
# Reads rules, writes only /run/nireekshana.
RuntimeDirectory=nireekshana
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
