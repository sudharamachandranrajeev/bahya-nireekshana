#!/usr/bin/python3 -I
"""Read and change the OpenSnitch rules and lists shown by the Bahya Nireekshana widget.

Runs as root: from the widget through pkexec (Omarchy's polkit prompt asks for
your password), and from nireekshana-rules-export.path whenever rules change.

  nireekshana-rules export                      write /run/nireekshana/rules.json for the widget
  nireekshana-rules set-action <rule.json> allow|deny
  nireekshana-rules delete <rule.json>
  nireekshana-rules list-add <list> <entry>     list: block-domains block-nets allow-domains allow-nets
  nireekshana-rules list-remove <list> <entry>

OpenSnitch saves its rules readable by root only, so the widget reads the
export instead. Every change re-exports, so the widget sees it at once.
"""

import grp
import ipaddress
import json
import os
import re
import sys
from datetime import datetime, timezone

RULES = "/etc/opensnitchd/rules"
LISTS = "/etc/opensnitchd/nireekshana"
EXPORT = "/run/nireekshana/rules.json"
EXPORT_GROUP = "wheel"

# list id -> kind of entry it holds
LIST_KINDS = {
    "block-domains": "domain",
    "block-nets": "net",
    "allow-domains": "domain",
    "allow-nets": "net",
}
OPPOSITE = {
    "block-domains": "allow-domains",
    "allow-domains": "block-domains",
    "block-nets": "allow-nets",
    "allow-nets": "block-nets",
}
# The rules that read the lists; change the lists, not these.
PROTECTED = re.compile(r"^00[01]-nireekshana-")
ACTION_PREFIX = re.compile(r"^(allow|deny|reject)-")
DOMAIN = re.compile(
    r"^(?=.{1,253}$)(?:[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
)
HOSTS_PREFIXES = ("0.0.0.0", "127.0.0.1", "::", "::1")


class Refused(Exception):
    """A request that would be unsafe or makes no sense; nothing was changed."""


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def write_in_place(path, text):
    # OpenSnitch reloads rules and lists on write events. Replacing the file by
    # rename shows up as a new file, which it doesn't reload, so rewrite it.
    with open(path, "w") as f:
        f.write(text)


# ---------- rules ----------

def rule_path(name):
    if "/" in name or name.startswith(".") or not name.endswith(".json"):
        raise Refused(f"not a rule file name: {name!r}")
    if PROTECTED.match(name):
        raise Refused(f"{name} holds a nireekshana list; change the list entries instead")
    path = os.path.join(RULES, name)
    if os.path.islink(path) or not os.path.isfile(path):
        raise Refused(f"no such rule: {name}")
    return path


def set_action(name, action):
    if action not in ("allow", "deny"):
        raise Refused(f"action must be allow or deny, not {action!r}")
    path = rule_path(name)
    with open(path) as f:
        rule = json.load(f)
    if rule.get("action") == action:
        return
    rule["action"] = action
    rule["updated"] = now()

    # Rules named after their action ("allow-always-…") get renamed to match.
    old_name = rule.get("name", "")
    new_name = ACTION_PREFIX.sub(action + "-", old_name) if ACTION_PREFIX.match(old_name) else old_name
    if new_name == old_name:
        write_in_place(path, json.dumps(rule, indent=2) + "\n")
        return
    new_path = os.path.join(RULES, new_name + ".json")
    if os.path.exists(new_path):
        raise Refused(f"a rule named {new_name} already exists; delete one of them first")
    rule["name"] = new_name
    # Write the new rule before removing the old, so there's no gap.
    fd = os.open(new_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(rule, indent=2) + "\n")
    os.unlink(path)


def delete(name):
    os.unlink(rule_path(name))


# ---------- lists ----------

def list_path(list_id):
    if list_id not in LIST_KINDS:
        raise Refused(f"unknown list: {list_id!r}")
    path = os.path.join(LISTS, list_id, "list.txt")
    if os.path.islink(path) or not os.path.isfile(path):
        raise Refused(f"{path} is missing; re-run ~/Work/bahya-nireekshana/omarchy/install.sh")
    return path


def normalize(kind, entry):
    entry = entry.strip().lower()
    if kind == "domain":
        entry = entry.rstrip(".")
        if entry.startswith("*.") or "*" in entry:
            raise Refused("wildcards aren't supported; add each domain name you want covered")
        if not DOMAIN.match(entry):
            raise Refused(f"not a domain name: {entry!r}")
        return entry
    try:
        net = ipaddress.ip_network(entry, strict=False)
    except ValueError:
        raise Refused(f"not an IP address or network: {entry!r}") from None
    if net.prefixlen == 0:
        raise Refused("that network covers every address")
    return str(net)


def parse_list(kind, text):
    """Entries in a list file, in file order, without comments."""
    entries = []
    for line in text.splitlines():
        fields = line.split("#", 1)[0].split()
        if not fields:
            continue
        if kind == "domain" and len(fields) >= 2 and fields[0] in HOSTS_PREFIXES:
            entries.append(fields[1].lower())
        elif kind == "domain":
            entries.append(fields[0].lower())
        else:
            entries.append(fields[0])
    return entries


def format_entry(kind, entry):
    return f"0.0.0.0 {entry}" if kind == "domain" else entry


def remove_from(list_id, entry):
    path = list_path(list_id)
    kind = LIST_KINDS[list_id]
    with open(path) as f:
        lines = f.read().splitlines()
    kept = [line for line in lines if parse_list(kind, line) != [entry]]
    if len(kept) != len(lines):
        write_in_place(path, "\n".join(kept) + "\n")


def list_add(list_id, raw):
    path = list_path(list_id)
    kind = LIST_KINDS[list_id]
    entry = normalize(kind, raw)
    # Blocking something that was always-allowed (or the reverse) moves it.
    opposite = os.path.join(LISTS, OPPOSITE[list_id], "list.txt")
    if os.path.isfile(opposite):
        remove_from(OPPOSITE[list_id], entry)
    with open(path) as f:
        text = f.read()
    if entry in parse_list(kind, text):
        return
    if text and not text.endswith("\n"):
        text += "\n"
    write_in_place(path, text + format_entry(kind, entry) + "\n")


def list_remove(list_id, raw):
    list_path(list_id)
    remove_from(list_id, normalize(LIST_KINDS[list_id], raw))


# ---------- export ----------

def summarize_operator(op):
    if not isinstance(op, dict):
        return {}
    out = {k: op.get(k) for k in ("type", "operand", "data", "sensitive")}
    if isinstance(op.get("list"), list) and op["list"]:
        out["list"] = [summarize_operator(sub) for sub in op["list"]]
    return out


def export():
    rules = []
    try:
        names = sorted(n for n in os.listdir(RULES) if n.endswith(".json"))
    except FileNotFoundError:
        names = []
    for name in names:
        entry = {"file": name}
        try:
            with open(os.path.join(RULES, name)) as f:
                rule = json.load(f)
            for key in ("name", "description", "action", "duration", "enabled", "precedence", "created", "updated"):
                entry[key] = rule.get(key)
            entry["operator"] = summarize_operator(rule.get("operator"))
        except (OSError, ValueError) as e:
            entry["error"] = str(e)
        rules.append(entry)

    lists = {}
    for list_id, kind in LIST_KINDS.items():
        try:
            with open(os.path.join(LISTS, list_id, "list.txt")) as f:
                lists[list_id] = parse_list(kind, f.read())
        except OSError:
            lists[list_id] = None  # not set up

    os.makedirs(os.path.dirname(EXPORT), mode=0o755, exist_ok=True)
    tmp = EXPORT + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"generated": now(), "rules": rules, "lists": lists}, f)
    try:
        os.chown(tmp, 0, grp.getgrnam(EXPORT_GROUP).gr_gid)
        os.chmod(tmp, 0o640)
    except KeyError:
        os.chmod(tmp, 0o644)
    os.replace(tmp, EXPORT)


# ---------- main ----------

COMMANDS = {
    "export": (export, 0),
    "set-action": (set_action, 2),
    "delete": (delete, 1),
    "list-add": (list_add, 2),
    "list-remove": (list_remove, 2),
}


def main(argv):
    if not argv or argv[0] not in COMMANDS or len(argv) - 1 != COMMANDS[argv[0]][1]:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("nireekshana-rules must run as root (the widget uses pkexec)", file=sys.stderr)
        return 1
    func, _ = COMMANDS[argv[0]]
    try:
        func(*argv[1:])
        if argv[0] != "export":
            export()
    except Refused as e:
        print(str(e), file=sys.stderr)
        return 3
    except OSError as e:
        print(f"{argv[0]} failed: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
