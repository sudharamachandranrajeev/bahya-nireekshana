#!/usr/bin/python3 -I
"""Count each program's network traffic per day, for Bahya Nireekshana's Apps page.

Runs as root under nireekshana-apps.service. It reads nethogs in trace mode
(`nethogs -t -C -v 2`), which prints each process's bytes sent and received
since nethogs started, and adds the growth to the day's totals for the
program. Every minute, and when stopped, it writes

    /var/lib/nireekshana/apps.json
    {"version": 1, "updated": "...", "days": {"2026-10-26": [
        {"app": "/usr/lib/firefox/firefox", "name": "firefox", "kind": "wifi",
         "rx": 123, "tx": 45}, ...]}}

world-readable, so the app reads it without privileges. The kind of network
is the one the default route used when the bytes were counted. Days older
than 400 are dropped.
"""

import datetime
import json
import os
import signal
import subprocess
import sys
import tempfile
import time

OUT = "/var/lib/nireekshana/apps.json"
KEEP_DAYS = 400
WRITE_EVERY = 60


def kind_of(iface):
    """The usage kind of an interface name, as lib/domain/counters.dart has it."""
    if iface.startswith("wl"):
        return "wifi"
    if iface.startswith(("en", "eth")):
        return "ethernet"
    if iface.startswith("ww"):
        return "mobile"
    return "other"


VIRTUAL = ("lo", "wg", "tun", "tap", "tailscale", "docker", "br-", "veth", "virbr", "zt")


def default_kind(route_text):
    """The kind of the physical interface carrying the default route, from /proc/net/route."""
    best = None
    for line in route_text.splitlines()[1:]:
        f = line.split()
        if len(f) < 8 or f[1] != "00000000" or f[0].startswith(VIRTUAL):
            continue
        metric = int(f[6])
        if best is None or metric < best[0]:
            best = (metric, f[0])
    return kind_of(best[1]) if best else "other"


def parse_line(line):
    """`program/pid/uid<TAB>sent<TAB>received` as (program, pid, sent, received), else None."""
    parts = line.rstrip("\n").split("\t")
    if len(parts) != 3:
        return None
    ident = parts[0].rsplit("/", 2)
    if len(ident) != 3:
        return None
    try:
        sent, received = int(float(parts[1])), int(float(parts[2]))
    except ValueError:
        return None
    return ident[0], ident[1], sent, received


def app_name(program):
    """A short name for a program: its file name, or nethogs' own label."""
    if program.startswith("unknown"):
        return "Unknown (system)"
    base = program.split()[0].rstrip("/").rsplit("/", 1)[-1]
    return base or program


class Counter:
    """Turns nethogs' running totals into per-day, per-program growth."""

    def __init__(self, days=None):
        # day -> (program, kind) -> [rx, tx]
        self.days = days or {}
        self.last = {}
        self.seen = set()

    def refresh(self):
        """A new block of lines starts: processes missing from the last one have ended."""
        self.last = {k: v for k, v in self.last.items() if k in self.seen}
        self.seen = set()

    def take(self, program, pid, sent, received, kind, day):
        key = (program, pid)
        self.seen.add(key)
        before = self.last.get(key, (0, 0))
        # A smaller total means nethogs restarted counting this process.
        tx = sent - before[0] if sent >= before[0] else sent
        rx = received - before[1] if received >= before[1] else received
        self.last[key] = (sent, received)
        if rx == 0 and tx == 0:
            return
        slot = self.days.setdefault(day, {}).setdefault((program, kind), [0, 0])
        slot[0] += rx
        slot[1] += tx

    def prune(self, today):
        cutoff = (datetime.date.fromisoformat(today) - datetime.timedelta(days=KEEP_DAYS)).isoformat()
        for day in [d for d in self.days if d < cutoff]:
            del self.days[day]

    def to_json(self, now):
        return {
            "version": 1,
            "updated": now,
            "days": {
                day: [
                    {"app": p, "name": app_name(p), "kind": k, "rx": v[0], "tx": v[1]}
                    for (p, k), v in sorted(rows.items())
                ]
                for day, rows in sorted(self.days.items())
            },
        }

    @staticmethod
    def from_json(data):
        days = {}
        for day, rows in (data.get("days") or {}).items():
            for r in rows:
                days.setdefault(day, {})[(r["app"], r["kind"])] = [int(r["rx"]), int(r["tx"])]
        return Counter(days)


def load(path):
    try:
        with open(path) as f:
            return Counter.from_json(json.load(f))
    except (OSError, ValueError, KeyError, TypeError):
        return Counter()


def save(counter, path):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".apps-")
    with os.fdopen(fd, "w") as f:
        json.dump(counter.to_json(now), f, separators=(",", ":"))
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def route_kind():
    try:
        with open("/proc/net/route") as f:
            return default_kind(f.read())
    except OSError:
        return "other"


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else OUT
    counter = load(path)
    proc = subprocess.Popen(
        ["nethogs", "-t", "-C", "-v", "2", "-d", "5"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    def stop(*_):
        proc.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    written = time.monotonic()
    kind = route_kind()
    for line in proc.stdout:
        if line.startswith("Refreshing"):
            counter.refresh()
            kind = route_kind()
            if time.monotonic() - written >= WRITE_EVERY:
                counter.prune(datetime.date.today().isoformat())
                save(counter, path)
                written = time.monotonic()
            continue
        row = parse_line(line)
        if row:
            counter.take(*row, kind, datetime.date.today().isoformat())
    save(counter, path)
    return proc.wait()


if __name__ == "__main__":
    sys.exit(main())
