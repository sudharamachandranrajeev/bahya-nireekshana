[Unit]
Description=Export OpenSnitch rules and netwatch lists for the bar widget
Documentation=file:///usr/local/bin/netwatch-rules
After=opensnitchd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/netwatch-rules export
# Reads rules, writes only /run/netwatch.
RuntimeDirectory=netwatch
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
